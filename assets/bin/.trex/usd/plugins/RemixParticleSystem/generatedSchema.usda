    uniform token primvars:particle:billboardType = "FaceCamera_Spherical" (
        allowedTokens = ["FaceCamera_Spherical", "FaceCamera_UpAxisLocked", "FaceCamera_Position", "FaceWorldUp"]
        displayGroup = "Visual"
        displayName = "Billboard Type"
        doc = """\r\r
                Selects the geometric orientation mode used when rendering each particle sprite.\r\r
\r\r
                0 = Face Camera (Spherical)\r\r
                    A fully camera-facing billboard. The particle quad always faces the camera, rotating freely in both axes.\r\r
\r\r
                1 = Face Camera - Up Axis Locked (Cylindrical)\r\r
                    The particle quad faces the camera around the world up axis only.\r\r
                    Useful for tall vertical effects like smoke columns or fire, which should not lean with the camera.\r\r
\r\r
                2 = Face Camera - Position\r\r
                    The particle quad faces toward the camera position, but does not rotate\r\r
                    when the camera rolls.\r\r
\r\r
                3 = Face World Up (Horizontal Plane)\r\r
                    The particle quad lies flat in a horizontal plane facing upDirection,\r\r
                    regardless of camera orientation. Suitable for ground dust, footprints, or water ripples.\r\r
\r\r
                """
    )
