        displayGroup = "Collision"
        displayName = "Collision Mode"
        doc = """\r\r
                Selects the collision mode for the particle - which controls behaviour on collision (if enabled).\r\r
\r\r
                0 = Bounce\r\r
                    Particle should bounce following collision.\r\r
\r\r
                1 = Stop\r\r
                    Stop all motion for the particle on collision.\r\r
\r\r
                2 = Kill\r\r
